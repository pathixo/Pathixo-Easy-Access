# ==============================================================================
# PATHIXO EXPO PLATFORM — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control or paste secrets in chat.
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-only: Never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Session Secret for signed HttpOnly visitor cookie (min 32 chars)
SESSION_SECRET=generate-a-random-32-character-secret-string

# Upstash Redis (for distributed rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here

# Cloudflare Turnstile (Bot protection)
# For development testing, you can use Cloudflare's official testing keys:
# Site Key: 1x00000000000000000000AA (always passes)
# Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Campaign Identifier
CAMPAIGN_ID=expo_mart_2026
